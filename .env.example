# Address the HTTP server listens on.
HTTP_ADDR=:8080
# Postgres connection string (required).
DATABASE_URL=postgres://points:points@localhost:5432/points?sslmode=disable
# Redis connection string, used for cooldowns, throttling and idempotency locks.
REDIS_URL=redis://localhost:6379/0
# Bearer token for the platform operator endpoint POST /platform/tenants (required).
PLATFORM_ADMIN_TOKEN=change-me
# Apply embedded schema migrations on startup.
AUTO_MIGRATE=true
DB_MAX_CONNS=20
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s
# How often time-based level changes (rolling windows, downgrades) are applied; 0 disables.
LEVEL_SWEEP_INTERVAL=1h
# How often expired points are removed from balances; 0 disables (points still expire on each
# entity's next transaction).
EXPIRY_SWEEP_INTERVAL=15m
